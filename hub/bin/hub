#!/usr/bin/env php
<?php

/**
 * Archive management CLI. Run this on the host that serves the archive.
 *
 *   php hub/bin/hub publish <path> [--channel=stable] [--changelog="..."] [--overwrite]
 *   php hub/bin/hub publish-core <path-to-botex> [--channel=] [--changelog=] [--overwrite]
 *   php hub/bin/hub list [--channel=stable]
 *   php hub/bin/hub show <slug>
 *   php hub/bin/hub unpublish <slug> <version>
 *   php hub/bin/hub reindex
 *   php hub/bin/hub verify [<slug>] [<version>]
 *   php hub/bin/hub keygen [--out=hub/storage/keys]
 *   php hub/bin/hub sync
 *   php hub/bin/hub serve [--port=8080]
 */

use Botex\Archive\ArchiveException;
use Hub\Autoload;
use Hub\Catalog;
use Hub\Config;
use Hub\Publisher;
use Hub\Store;

if (PHP_SAPI !== 'cli') {
    exit(1);
}

require __DIR__ . '/../src/Autoload.php';

Autoload::register();

function fail(string $message): never
{
    fwrite(STDERR, $message . PHP_EOL);
    exit(1);
}

/** Reads --name=value from argv. */
function option(array $argv, string $name, ?string $default = null): ?string
{
    foreach ($argv as $argument) {
        if (str_starts_with($argument, "--{$name}=")) {
            return substr($argument, strlen($name) + 3);
        }
    }

    return $default;
}

function flag(array $argv, string $name): bool
{
    return in_array("--{$name}", $argv, true);
}

/** Positional arguments, with flags removed. */
function positional(array $argv): array
{
    return array_values(array_filter(
        array_slice($argv, 2),
        static fn (string $a): bool => !str_starts_with($a, '--')
    ));
}

$config = Config::load();
$store = new Store($config);
$catalog = new Catalog($config, $store);
$publisher = new Publisher($config, $store, $catalog);

$command = $argv[1] ?? 'list';
$arguments = positional($argv);

try {
    switch ($command) {

        case 'publish':
            $path = $arguments[0] ?? fail('Usage: hub publish <path-to-extension-folder>');

            $manifest = $publisher->extension(
                directory: $path,
                channel: option($argv, 'channel'),
                version: option($argv, 'version'),
                changelog: (string) option($argv, 'changelog', ''),
                overwrite: flag($argv, 'overwrite')
            );

            printf(
                "Published %s %s to %s (%d files).\n",
                $manifest->slug,
                $manifest->version,
                option($argv, 'channel') ?? $config->defaultChannel(),
                count($manifest->files)
            );

            echo '  install with: ' . $manifest->command('install') . PHP_EOL;
            break;

        case 'publish-core':
            $path = $arguments[0] ?? fail('Usage: hub publish-core <path-to-botex-checkout>');

            $manifest = $publisher->core(
                directory: $path,
                channel: option($argv, 'channel'),
                version: option($argv, 'version'),
                changelog: (string) option($argv, 'changelog', ''),
                overwrite: flag($argv, 'overwrite')
            );

            printf(
                "Published core %s to %s (%d files).\n",
                $manifest->version,
                option($argv, 'channel') ?? $config->defaultChannel(),
                count($manifest->files)
            );
            break;

        case 'list':
            $channel = $config->channel(option($argv, 'channel'));
            $packages = $catalog->all($channel);

            if ($packages === []) {
                echo "Nothing published on {$channel}." . PHP_EOL;
                break;
            }

            printf("%-16s %-10s %-9s %-7s %s\n", 'SLUG', 'TYPE', 'VERSION', 'SIGNED', 'NAME');

            foreach ($packages as $entry) {
                printf(
                    "%-16s %-10s %-9s %-7s %s\n",
                    $entry['slug'],
                    $entry['type'],
                    $entry['version'],
                    ($entry['signed'] ?? false) ? 'yes' : 'no',
                    $entry['name']
                );
            }

            printf("\n%d package(s) on %s.\n", count($packages), $channel);
            break;

        case 'show':
            $slug = $arguments[0] ?? fail('Usage: hub show <slug>');
            $channel = $config->channel(option($argv, 'channel'));
            $entry = $catalog->find($slug, $channel);

            if ($entry === null) {
                fail("Nothing published as '{$slug}' on {$channel}.");
            }

            echo $entry['name'] . ' (' . $entry['slug'] . ')' . PHP_EOL;
            echo str_repeat('-', 40) . PHP_EOL;
            echo 'Type:        ' . $entry['type'] . PHP_EOL;
            echo 'Current:     ' . $entry['version'] . PHP_EOL;
            echo 'Downloads:   ' . $entry['downloads'] . PHP_EOL;

            if ($entry['description'] !== '') {
                echo 'Description: ' . $entry['description'] . PHP_EOL;
            }

            if ($entry['requires'] !== []) {
                foreach ($entry['requires'] as $what => $constraint) {
                    echo 'Requires:    ' . $what . ' ' . $constraint . PHP_EOL;
                }
            }

            echo PHP_EOL . 'Versions:' . PHP_EOL;

            foreach ($entry['releases'] as $release) {
                printf(
                    "  %-9s %-8s %8s  %s%s\n",
                    $release['version'],
                    $release['channel'],
                    $release['size'] > 0 ? round($release['size'] / 1024, 1) . 'K' : '-',
                    substr((string) $release['published_at'], 0, 10),
                    ($release['signed'] ?? false) ? '  signed' : ''
                );

                if (($release['changelog'] ?? '') !== '') {
                    echo '            ' . $release['changelog'] . PHP_EOL;
                }
            }

            echo PHP_EOL . 'Commands:' . PHP_EOL;

            foreach ($entry['commands'] as $which => $line) {
                if ($line !== '') {
                    printf("  %-8s %s\n", $which, $line);
                }
            }

            break;

        case 'unpublish':
            $slug = $arguments[0] ?? fail('Usage: hub unpublish <slug> <version>');
            $version = $arguments[1] ?? fail('Usage: hub unpublish <slug> <version>');

            if (!$publisher->unpublish($slug, $version)) {
                fail("Nothing published as {$slug} {$version}.");
            }

            echo "Unpublished {$slug} {$version}." . PHP_EOL;
            break;

        case 'reindex':
            $index = $catalog->rebuild();

            printf(
                "Reindexed %d package(s) at %s.\n",
                count($index['packages']),
                $index['generated_at']
            );

            break;

        case 'verify':
            $slug = $arguments[0] ?? null;
            $checked = 0;
            $failed = 0;

            foreach ($slug === null ? $store->slugs() : [$slug] as $each) {
                foreach ($store->versions($each) as $version) {
                    $checked++;

                    try {
                        $package = $store->package($each, $version);
                        $release = $store->release($each, $version);
                        $bytes = $store->bytes($each, $version);

                        // The stored hash must still describe the stored
                        // file: bit rot and a bad copy both show up here.
                        if ($release['sha256'] !== '' &&
                            !\Botex\Archive\Hash::matches($release['sha256'], \Botex\Archive\Hash::string($bytes))
                        ) {
                            throw new ArchiveException('the stored hash does not match the file');
                        }

                        printf("  ok    %s %s (%d files)\n", $each, $version, count($package->files()));
                    } catch (\Throwable $e) {
                        $failed++;
                        printf("  FAIL  %s %s: %s\n", $each, $version, $e->getMessage());
                    }
                }
            }

            printf("\n%d release(s) checked, %d failed.\n", $checked, $failed);

            if ($failed > 0) {
                exit(1);
            }

            break;

        case 'keygen':
            $out = rtrim((string) option($argv, 'out', $config->storage() . '/keys'), '/\\');
            $written = Hub\Keys::write($out, (int) option($argv, 'bits', (string) Hub\Keys::BITS));

            echo 'Wrote:' . PHP_EOL;
            echo '  ' . $written['private'] . '   (private -- keep it out of the web root)' . PHP_EOL;
            echo '  ' . $written['public'] . '   (public)' . PHP_EOL . PHP_EOL;
            echo 'Next:' . PHP_EOL;
            echo "  1. set 'signing_key' => '{$written['private']}' in hub/config.php" . PHP_EOL;
            echo '  2. republish anything you want signed, with --overwrite' . PHP_EOL;
            echo "  3. paste the PUBLIC key into each bot's config/config.php" . PHP_EOL;
            echo '     as archive.public_key -- from then on it refuses unsigned packages' . PHP_EOL;
            break;

        // Copies the shared archive classes from the bot into the hub, so a
        // deployed hub carries its own copy and needs nothing beside it.
        case 'sync':
            $from = dirname(__DIR__, 2) . '/src/Archive';
            $to = dirname(__DIR__) . '/src/Archive';

            if (!is_dir($from)) {
                fail("Cannot find the bot's src/Archive at {$from}. Run this from a full checkout.");
            }

            if (!is_dir($to) && !@mkdir($to, 0775, true) && !is_dir($to)) {
                fail("Could not create {$to}");
            }

            $copied = 0;

            foreach ((array) glob($from . '/*.php') as $file) {
                if (@copy((string) $file, $to . '/' . basename((string) $file))) {
                    $copied++;
                }
            }

            // Botex.php comes too: Manifest reads the package format
            // constant off it.
            if (@copy(dirname(__DIR__, 2) . '/src/Botex.php', $to . '/Botex.php')) {
                $copied++;
            }

            echo "Synced {$copied} shared file(s) into hub/src/Archive." . PHP_EOL;
            break;

        // Development convenience: PHP's own server, pointed at public/.
        case 'serve':
            $port = (int) option($argv, 'port', '8080');
            $docroot = dirname(__DIR__) . '/public';

            echo "Serving {$docroot} on http://localhost:{$port}" . PHP_EOL;
            echo 'Point a bot at it with:' . PHP_EOL;
            echo "  'url' => 'http://localhost:{$port}'," . PHP_EOL . PHP_EOL;

            passthru(sprintf(
                '%s -S localhost:%d -t %s %s',
                escapeshellarg(PHP_BINARY),
                $port,
                escapeshellarg($docroot),
                escapeshellarg($docroot . '/index.php')
            ));

            break;

        default:
            fail("Unknown command '{$command}'. Try: publish, publish-core, list, show, unpublish, reindex, verify, keygen, sync, serve.");
    }
} catch (\Throwable $e) {
    fail('Error: ' . $e->getMessage());
}
