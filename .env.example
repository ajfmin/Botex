BOT_TOKEN=
DB_HOST=127.0.0.1
DB_NAME=
DB_USER=
DB_PASSWORD=
# Comma separated telegram ids allowed to run admin commands
ADMIN_IDS=
# Token for /panel.php. Leave empty to disable the panel entirely.
PANEL_TOKEN=
# Wallet currency label. Balances are stored as integer minor units.
WALLET_CURRENCY=IRT
# Minor units per whole unit as a power of ten: 0 for Toman, 2 for USD cents.
WALLET_SCALE=0
# Seconds a rendered Run button stays pressable. Default one week.
ACTION_TTL=604800
# Prune expired actions on roughly 1 in N updates.
ACTION_PRUNE_CHANCE=200
# Seconds the job worker waits between polls when nothing is due.
JOB_SLEEP=5
# Seconds a claimed job stays owned before it counts as abandoned.
JOB_LEASE=300
# Attempts a failing job gets before it is marked failed.
JOB_MAX_ATTEMPTS=3
# Seconds finished job rows are kept. 0 disables the core prune job.
JOB_KEEP_FINISHED=604800
# Messages a second a broadcast goes out at. Telegram starts refusing
# somewhere around 30, and the resulting flood wait applies to every
# message the bot sends, not just the announcement. Capped at 30.
BROADCAST_RATE=15
# Seconds of sending per worker run, before the worker is handed back
# to everything else that is scheduled.
BROADCAST_SLICE=30
# Quietest log level written to storage/logs: debug, info, notice,
# warning, error, critical. debug is very chatty in production.
LOG_LEVEL=info
# Days of daily log files to keep. 0 never prunes.
LOG_KEEP_DAYS=14
# Chat (a group is usual) that important log entries are posted to.
# Leave empty to never notify. Negative for a supergroup, e.g. -1001234.
LOG_CHAT=
# Quietest level that sends that notification. error is the sane default.
LOG_NOTIFY_LEVEL=error
# Anthropic API key, used by extensions that read images or text with
# Claude (CardToCardReceipt reads the paid amount off a transfer receipt).
# Leave empty to switch those readings off; the extension still works,
# it just hands every receipt to an admin with no suggestion on it.
ANTHROPIC_API_KEY=
